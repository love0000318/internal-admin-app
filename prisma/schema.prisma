model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  name         String
  title        String?
  teamId       String?
  hireDate     DateTime?  @db.Date
  birthDate    DateTime?  @db.Date
  role         Role       @default(MANAGER)
  status       UserStatus @default(INVITED)
  passwordHash String?
  lastLoginAt  DateTime?
  deactivatedAt DateTime?
  deletedAt    DateTime?
  deletedByUserId String?
  deletionReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile               EmployeeProfile?
  deletedBy             User?                 @relation("UserDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletedUsers          User[]                @relation("UserDeletedBy")
  team                  Team?                  @relation("UserTeam", fields: [teamId], references: [id], onDelete: SetNull)
  leadTeams             Team[]                 @relation("TeamLead")
  sentInvitations       Invitation[]           @relation("InvitationsSent")
  acceptedInvitation    Invitation?            @relation("InvitationAccepted")
  identityVerifications IdentityVerification[]
  sessions              Session[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]         @relation("UserLeaveRequests")
  reviewedLeaveRequests LeaveRequest[]         @relation("LeaveReviews")
  uploadedLeaveAttachments LeaveAttachment[]    @relation("LeaveAttachmentUploadedBy")
  reviewedLeaveAttachments LeaveAttachment[]    @relation("LeaveAttachmentReviewedBy")
  deletedLeaveAttachments  LeaveAttachment[]    @relation("LeaveAttachmentDeletedBy")
  customApprovalPolicies   ApprovalPolicy[]     @relation("ApprovalPolicyCustomApprover")
  leaveAdjustments      LeaveAdjustment[]      @relation("AdjustedUser")
  createdAdjustments    LeaveAdjustment[]      @relation("AdjustmentCreator")
  leaveGrants           LeaveGrant[]           @relation("LeaveGrantUser")
  leaveGrantsCreated    LeaveGrant[]           @relation("LeaveGrantGrantedBy")
  leaveGrantsRevoked    LeaveGrant[]           @relation("LeaveGrantRevokedBy")
  leaveLedgers          LeaveLedger[]          @relation("LeaveLedgerUser")
  createdLeaveLedgers   LeaveLedger[]          @relation("LeaveLedgerCreatedBy")
  uploadedLeaveImportBatches LeaveImportBatch[] @relation("LeaveImportUploadedBy")
  appliedLeaveImportBatches  LeaveImportBatch[] @relation("LeaveImportAppliedBy")
  reversedLeaveImportBatches LeaveImportBatch[] @relation("LeaveImportReversedBy")
  matchedLeaveImportRows     LeaveImportRow[]   @relation("LeaveImportRowMatchedUser")
  annualLeavePoliciesApproved AnnualLeavePolicy[] @relation("AnnualLeavePolicyPromotionApprover")
  annualLeavePromotionNotices AnnualLeavePromotionNotice[]
  annualLeaveUsePlans AnnualLeaveUsePlan[]
  notifications         Notification[]
  calendarSubscriptionTokens CalendarSubscriptionToken[]
  stepUpVerifications   StepUpVerification[]
  attendanceRecords      AttendanceRecord[]       @relation("AttendanceRecordUser")
  attendanceChangeRequests AttendanceChangeRequest[] @relation("AttendanceChangeRequestUser")
  reviewedAttendanceChangeRequests AttendanceChangeRequest[] @relation("AttendanceChangeRequestReviewer")
  attendanceMonthsClosed AttendanceMonthlyClose[] @relation("AttendanceMonthlyClosedBy")
  attendanceMonthsReopened AttendanceMonthlyClose[] @relation("AttendanceMonthlyReopenedBy")
  triggeredJobRuns      JobRun[]                @relation("JobRunTriggeredByUser")
  auditLogs             AuditLog[]
  importedEmployeeBatches EmployeeImportBatch[] @relation("EmployeeImportImportedBy")
  linkedPrejoinProfiles EmployeePrejoinProfile[] @relation("PrejoinLinkedUser")
  sensitiveProfile      EmployeeSensitiveProfile?
  employmentProfile     EmploymentProfile?
  employmentContracts   EmploymentContractProfile[]
  compensationProfiles  CompensationProfile[]
  familyMembers         FamilyMember[]
  careerRecords         CareerRecord[]
  educationRecords      EducationRecord[]
  languageSkills        LanguageSkill[]
  certificateRecords    CertificateRecord[]
  projectSkillRecords   ProjectSkillRecord[]
  trainingRecords       TrainingRecord[]
  profileChangeRequests EmployeeProfileChangeRequest[] @relation("ProfileChangeRequestUser")
  reviewedProfileChangeRequests EmployeeProfileChangeRequest[] @relation("ProfileChangeRequestReviewer")
  updatedWorkTaskLocalStates WorkTaskLocalState[] @relation("WorkTaskLocalStateUpdatedBy")
  linkedWorkTaskDocuments WorkTaskDocumentLink[] @relation("WorkTaskDocumentLinkLinkedBy")
  checkedWorkTaskChangeRequests WorkTaskChangeRequest[] @relation("WorkTaskChangeRequestCheckedBy")
  workTaskActivities WorkTaskActivity[] @relation("WorkTaskActivityActor")

  @@index([status])
  @@index([role])
  @@index([teamId])
  @@index([deletedAt])
  @@index([deletedByUserId])
}

model Team {
  id            String     @id @default(cuid())
  name          String
  description   String?
  parentTeamId  String?
  leadUserId    String?
  status        TeamStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  parent      Team?             @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children    Team[]            @relation("TeamHierarchy")
  lead        User?             @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members     User[]            @relation("UserTeam")
  profiles    EmployeeProfile[]
  invitations Invitation[]
  calendarSubscriptionTokens CalendarSubscriptionToken[]
  workTaskLocalStates WorkTaskLocalState[] @relation("WorkTaskLocalStateTeam")

  @@index([parentTeamId])
  @@index([leadUserId])
  @@index([status])
  @@unique([parentTeamId, name])
}

model CalendarSubscriptionToken {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  scope           CalendarSubscriptionScope
  teamId          String?
  name            String?
  isEnabled       Boolean  @default(true)
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scope])
  @@index([teamId])
  @@index([revokedAt])
}

model StepUpVerification {
  id         String        @id @default(cuid())
  userId     String
  purpose    StepUpPurpose
  verifiedAt DateTime      @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([revokedAt])
}

