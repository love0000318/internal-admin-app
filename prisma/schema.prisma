model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  name         String
  title        String?
  teamId       String?
  hireDate     DateTime?  @db.Date
  birthDate    DateTime?  @db.Date
  role         Role       @default(MANAGER)
  status       UserStatus @default(INVITED)
  passwordHash String?
  lastLoginAt  DateTime?
  deactivatedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile               EmployeeProfile?
  team                  Team?                  @relation("UserTeam", fields: [teamId], references: [id], onDelete: SetNull)
  leadTeams             Team[]                 @relation("TeamLead")
  sentInvitations       Invitation[]           @relation("InvitationsSent")
  acceptedInvitation    Invitation?            @relation("InvitationAccepted")
  identityVerifications IdentityVerification[]
  sessions              Session[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]         @relation("UserLeaveRequests")
  reviewedLeaveRequests LeaveRequest[]         @relation("LeaveReviews")
  uploadedLeaveAttachments LeaveAttachment[]    @relation("LeaveAttachmentUploadedBy")
  reviewedLeaveAttachments LeaveAttachment[]    @relation("LeaveAttachmentReviewedBy")
  deletedLeaveAttachments  LeaveAttachment[]    @relation("LeaveAttachmentDeletedBy")
  customApprovalPolicies   ApprovalPolicy[]     @relation("ApprovalPolicyCustomApprover")
  leaveAdjustments      LeaveAdjustment[]      @relation("AdjustedUser")
  createdAdjustments    LeaveAdjustment[]      @relation("AdjustmentCreator")
  leaveGrants           LeaveGrant[]           @relation("LeaveGrantUser")
  leaveGrantsCreated    LeaveGrant[]           @relation("LeaveGrantGrantedBy")
  leaveGrantsRevoked    LeaveGrant[]           @relation("LeaveGrantRevokedBy")
  leaveLedgers          LeaveLedger[]          @relation("LeaveLedgerUser")
  createdLeaveLedgers   LeaveLedger[]          @relation("LeaveLedgerCreatedBy")
  annualLeavePoliciesApproved AnnualLeavePolicy[] @relation("AnnualLeavePolicyPromotionApprover")
  annualLeavePromotionNotices AnnualLeavePromotionNotice[]
  annualLeaveUsePlans AnnualLeaveUsePlan[]
  notifications         Notification[]
  triggeredJobRuns      JobRun[]                @relation("JobRunTriggeredByUser")
  auditLogs             AuditLog[]
  importedEmployeeBatches EmployeeImportBatch[] @relation("EmployeeImportImportedBy")
  linkedPrejoinProfiles EmployeePrejoinProfile[] @relation("PrejoinLinkedUser")
  sensitiveProfile      EmployeeSensitiveProfile?
  employmentProfile     EmploymentProfile?
  employmentContracts   EmploymentContractProfile[]
  compensationProfiles  CompensationProfile[]
  familyMembers         FamilyMember[]
  careerRecords         CareerRecord[]
  educationRecords      EducationRecord[]
  languageSkills        LanguageSkill[]
  certificateRecords    CertificateRecord[]
  projectSkillRecords   ProjectSkillRecord[]
  trainingRecords       TrainingRecord[]
  profileChangeRequests EmployeeProfileChangeRequest[] @relation("ProfileChangeRequestUser")
  reviewedProfileChangeRequests EmployeeProfileChangeRequest[] @relation("ProfileChangeRequestReviewer")

  @@index([status])
  @@index([role])
  @@index([teamId])
}

model Team {
  id            String     @id @default(cuid())
  name          String
  description   String?
  parentTeamId  String?
  leadUserId    String?
  status        TeamStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  parent      Team?             @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children    Team[]            @relation("TeamHierarchy")
  lead        User?             @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members     User[]            @relation("UserTeam")
  profiles    EmployeeProfile[]
  invitations Invitation[]

  @@index([parentTeamId])
  @@index([leadUserId])
  @@index([status])
  @@unique([parentTeamId, name])
}

model EmployeeProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  teamId        String?
  jobTitle      String?
  hireDate      DateTime? @db.Date
  birthday      DateTime? @db.Date
  employeeNumber String?
  legalName      String?
  displayName    String?
  englishName    String?
  birthDate      DateTime? @db.Date
  legalGender    String?
  personalEmail  String?
  phoneCountryCode String?
  phoneNumber    String?
  nationalityCode String?
  residenceCountry String?
  visaStatus     String?
  address        String?
  postalCode     String?
  profileCompletedAt DateTime?
  lastConfirmedAt DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([employeeNumber])
}

model EmployeeImportBatch {
  id               String                    @id @default(cuid())
  fileName         String
  importedByUserId String?
  totalRows        Int                       @default(0)
  successRows      Int                       @default(0)
  failedRows       Int                       @default(0)
  status           EmployeeImportBatchStatus @default(PENDING)
  errorSummary     String?
  createdAt        DateTime                  @default(now())

  importedByUser User? @relation("EmployeeImportImportedBy", fields: [importedByUserId], references: [id], onDelete: SetNull)
  profiles       EmployeePrejoinProfile[]

  @@index([status])
  @@index([createdAt])
}

model EmployeePrejoinProfile {
  id             String                       @id @default(cuid())
  importBatchId  String?
  employeeNumber String?
  legalName      String
  displayName    String?
  companyEmail   String
  personalEmail  String?
  phoneNumber    String?
  employmentStatus String?
  title          String?
  position       String?
  jobGrade       String?
  roleSuggestion Role?
  teamName       String?
  teamCode       String?
  hireDate       DateTime?                    @db.Date
  groupHireDate  DateTime?                    @db.Date
  birthDate      DateTime?                    @db.Date
  englishName    String?
  legalGender    String?
  phoneCountryCode String?
  nationalityCode String?
  residenceCountry String?
  visaStatus     String?
  address        String?
  postalCode     String?
  residentIdEncrypted String?
  bankCode       String?
  bankName       String?
  bankAccountEncrypted String?
  bankAccountHolder String?
  swiftCode      String?
  veteranOrDisabledStatus String?
  disabilityGrade String?
  sourceStatus   EmployeePrejoinProfileStatus @default(IMPORTED)
  linkedUserId   String?
  linkedInvitationId String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  importBatch    EmployeeImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  linkedUser     User?                @relation("PrejoinLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  invitations    Invitation[]         @relation("InvitationPrejoin")
  families       FamilyMemberDraft[]
  careers        CareerRecordDraft[]
  educations     EducationRecordDraft[]
  languages      LanguageSkillDraft[]
  certificates   CertificateRecordDraft[]
  projectSkills  ProjectSkillRecordDraft[]
  trainings      TrainingRecordDraft[]

  @@unique([companyEmail])
  @@index([employeeNumber])
  @@index([sourceStatus])
  @@index([linkedUserId])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  name           String?
  expectedName   String
  role           Role             @default(MANAGER)
  teamId         String?
  title          String?
  jobTitle       String?
  hireDate       DateTime?        @db.Date
  birthDate      DateTime?        @db.Date
  birthday       DateTime?        @db.Date
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  usedAt         DateTime?
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  invitedByUserId String?
  acceptedByUserId String?
  createdById    String?
  acceptedUserId String?          @unique
  employeePrejoinProfileId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  team                  Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation("InvitationsSent", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedUser          User?                  @relation("InvitationAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  employeePrejoinProfile EmployeePrejoinProfile? @relation("InvitationPrejoin", fields: [employeePrejoinProfileId], references: [id], onDelete: SetNull)
  identityVerifications IdentityVerification[]

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([employeePrejoinProfileId])
}

model IdentityVerification {
  id             String   @id @default(cuid())
  userId         String?
  invitationId   String?
  provider       String
  verifiedName   String
  verifiedPhone  String
  providerRef    String?
  verifiedAt     DateTime
  createdAt      DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([invitationId])
  @@index([verifiedPhone])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LeavePolicy {
  id                           String    @id @default(cuid())
  type                         LeaveType @unique
  name                         String    @default("")
  description                  String?
  isEnabled                    Boolean   @default(true)
  deductsAnnual                Boolean   @default(false)
  deductsAnnualBalance         Boolean   @default(false)
  maxDaysPerRequest            Decimal?  @db.Decimal(4, 1)
  minRequestDays               Decimal?  @db.Decimal(4, 1)
  maxRequestDays               Decimal?  @db.Decimal(4, 1)
  maxDaysPerYear               Decimal?  @db.Decimal(4, 1)
  requestWindowStartOffsetDays Int?
  requestWindowEndOffsetDays   Int?
  requiresAttachment           Boolean   @default(false)
  approvalRequired             Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
}

model LeaveTypeDefinition {
  id                        String                    @id @default(cuid())
  code                      String                    @unique
  name                      String
  description               String?
  category                  LeaveCategory
  isSystemRequired          Boolean                   @default(false)
  isEnabled                 Boolean                   @default(true)
  isPaid                    Boolean                   @default(true)
  paidRate                  Float                     @default(1.0)
  grantMethod               LeaveGrantMethod          @default(MANUAL)
  grantAmount               Float?
  grantUnit                 LeaveGrantUnit            @default(DAY)
  usageMode                 LeaveUsageMode            @default(SPLIT_ALLOWED)
  allowedUnits              String
  unusedRemainderHandling   UnusedRemainderHandling   @default(KEEP_REMAINING)
  deductsAnnualBalance      Boolean                   @default(false)
  attachmentPolicy          AttachmentPolicy          @default(NOT_REQUIRED)
  attachmentDescription     String?
  includeHolidayInDeduction Boolean                   @default(false)
  visibility                LeaveVisibility           @default(PUBLIC_WITH_TYPE)
  approvalPolicyId          String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  grants                    LeaveGrant[]
  birthdayLeavePolicies     BirthdayLeavePolicy[]
  leaveRequests             LeaveRequest[]           @relation("CustomLeaveTypeRequests")
  leaveLedgers              LeaveLedger[]
  approvalPolicy            ApprovalPolicy?          @relation("LeaveTypeAssignedApprovalPolicy", fields: [approvalPolicyId], references: [id], onDelete: SetNull)
  appliedApprovalPolicies   ApprovalPolicy[]         @relation("ApprovalPolicyAppliesToLeaveType")

  @@index([category])
  @@index([isEnabled])
  @@index([isSystemRequired])
  @@index([approvalPolicyId])
}

model ApprovalPolicy {
  id                       String             @id @default(cuid())
  code                     String             @unique
  name                     String
  description              String?
  appliesTo                ApprovalAppliesTo  @default(LEAVE_REQUEST)
  leaveTypeId              String?
  approvalMode             ApprovalMode       @default(SINGLE)
  approverRule             ApproverRule       @default(TEAM_LEAD_OR_OWNER)
  customApproverUserId     String?
  requireCommentOnReject   Boolean            @default(true)
  requireCommentOnCancel   Boolean            @default(true)
  requireAttachmentAcceptedBeforeApproval Boolean @default(false)
  autoApproveIfNoApprover  Boolean            @default(false)
  autoConfirmWhenStartDatePassed Boolean      @default(true)
  autoConfirmTiming        AutoConfirmTiming   @default(ON_START_DATE)
  isEnabled                Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  leaveType                LeaveTypeDefinition?  @relation("ApprovalPolicyAppliesToLeaveType", fields: [leaveTypeId], references: [id], onDelete: SetNull)
  customApprover           User?                 @relation("ApprovalPolicyCustomApprover", fields: [customApproverUserId], references: [id], onDelete: SetNull)
  assignedLeaveTypes       LeaveTypeDefinition[] @relation("LeaveTypeAssignedApprovalPolicy")

  @@index([leaveTypeId])
  @@index([customApproverUserId])
  @@index([isEnabled])
}

model LeaveGrant {
  id              String           @id @default(cuid())
  userId          String
  leaveTypeId     String
  grantedAmount   Float
  usedAmount      Float            @default(0)
  pendingAmount   Float            @default(0)
  remainingAmount Float
  unit            LeaveGrantUnit
  status          LeaveGrantStatus @default(ACTIVE)
  effectiveFrom   DateTime         @db.Date
  expiresAt       DateTime?        @db.Date
  grantedByUserId String
  revokedByUserId String?
  revokedAt       DateTime?
  revokeReason    String?
  reason          String
  source          LeaveGrantSource @default(MANUAL)
  referenceYear   Int?
  referenceDate   DateTime?        @db.Date
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User                @relation("LeaveGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  leaveType       LeaveTypeDefinition @relation(fields: [leaveTypeId], references: [id])
  grantedByUser   User                @relation("LeaveGrantGrantedBy", fields: [grantedByUserId], references: [id])
