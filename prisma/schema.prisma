model LeaveRequest {
  id            String             @id @default(cuid())
  userId        String
  type          LeaveType
  requestKind   LeaveRequestKind   @default(LEGACY)
  leaveTypeId   String?
  status        LeaveRequestStatus @default(PENDING)
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  halfDayPeriod HalfDayPeriod?
  dayCount      Decimal            @db.Decimal(4, 1)
  reason        String?
  attachmentRequired Boolean       @default(false)
  attachmentUrl String?
  attachmentStatus LeaveRequestAttachmentStatus @default(NOT_REQUIRED)
  reviewerId    String?
  reviewedAt    DateTime?
  reviewComment String?
  rejectReason  String?
  cancelReason  String?
  withdrawnAt   DateTime?
  cancelledAt   DateTime?
  autoConfirmedAt DateTime?
  autoConfirmReason String?
  approvalSource LeaveApprovalSource? @default(MANUAL)
  importBatchId String?
  importRowId String? @unique
  importedAt DateTime?
  isImported Boolean @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user     User  @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("LeaveReviews", fields: [reviewerId], references: [id], onDelete: SetNull)
  customLeaveType LeaveTypeDefinition? @relation("CustomLeaveTypeRequests", fields: [leaveTypeId], references: [id], onDelete: SetNull)
  grantUsages LeaveRequestGrantUsage[]
  leaveLedgers LeaveLedger[]
  attachments LeaveAttachment[]

  @@index([userId, status])
  @@index([reviewerId])
  @@index([startDate, endDate])
  @@index([type, status])
  @@index([requestKind])
  @@index([leaveTypeId])
  @@index([attachmentStatus])
  @@index([importBatchId])
  @@index([isImported])
}

model LeaveImportBatch {
