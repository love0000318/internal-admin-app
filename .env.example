# Local development environment template.
# Do not commit real secrets. Copy to .env or .env.local for local use.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internal_ops_mvp?schema=public"
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

APP_SECRET="replace-with-at-least-32-random-characters"
SESSION_SECRET="replace-with-at-least-32-random-characters"
TOKEN_SECRET="replace-with-at-least-32-random-characters"
INVITATION_TOKEN_SECRET="replace-with-at-least-32-random-characters"
INVITATION_SHORT_TOKEN_SECRET="replace-with-at-least-32-random-characters"
INVITATION_VERIFICATION_CODE_SECRET="replace-with-at-least-32-random-characters"
ENCRYPTION_SECRET="replace-with-at-least-32-random-characters"
CRON_SECRET="replace-with-at-least-32-random-characters"

INVITATION_EXPIRES_IN_DAYS="14"
INVITATION_VERIFICATION_CODE_EXPIRES_IN_DAYS="14"
INVITATION_VERIFICATION_CODE_MAX_ATTEMPTS="5"
INVITATION_VERIFICATION_CODE_LENGTH="8"
INVITATION_SHORT_TOKEN_EXPIRES_IN_DAYS="14"
INVITATION_SHORT_TOKEN_LENGTH="8"
SESSION_EXPIRES_IN_DAYS="14"
REMEMBER_ME_SESSION_EXPIRES_IN_DAYS="30"
STEP_UP_EXPIRES_IN_MINUTES="5"
STEP_UP_MAX_ATTEMPTS="5"
MAX_LEAVE_IMPORT_FILE_SIZE_MB="10"

COOKIE_DOMAIN=""
EMAIL_FROM=""
EMAIL_PROVIDER="console"
EMAIL_REPLY_TO=""
RESEND_API_KEY=""
EXTERNAL_EMAIL_NOTIFICATIONS_ENABLED="false"
SLACK_NOTIFICATIONS_ENABLED="false"
SLACK_WEBHOOK_URL=""
SLACK_NOTIFY_JOB_FAILURES="true"
SLACK_NOTIFY_LEAVE_REQUESTS="false"
IDENTITY_VERIFICATION_PROVIDER="mock"
LOG_LEVEL="debug"

LEAVE_ATTACHMENT_STORAGE="local"
MAX_LEAVE_ATTACHMENT_SIZE_MB="10"
PRIVATE_UPLOAD_DIR="private/uploads"

SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Owner Name"
SEED_OWNER_TITLE="Owner"
