# Production environment template.
# Do not commit real secrets. Register real values in Vercel Project Settings.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/internal_ops_mvp?schema=public"
APP_BASE_URL="https://your-production-domain.example"
NODE_ENV="production"

# All secrets below must be different long random strings, at least 32 characters.
APP_SECRET="replace-with-different-long-random-string-at-least-32-characters"
SESSION_SECRET="replace-with-different-long-random-string-at-least-32-characters"
ENCRYPTION_SECRET="replace-with-different-long-random-string-at-least-32-characters"
TOKEN_SECRET="replace-with-different-long-random-string-at-least-32-characters"
INVITATION_TOKEN_SECRET="replace-with-different-long-random-string-at-least-32-characters"
INVITATION_SHORT_TOKEN_SECRET="replace-with-different-long-random-string-at-least-32-characters"
INVITATION_VERIFICATION_CODE_SECRET="replace-with-different-long-random-string-at-least-32-characters"
CRON_SECRET="replace-with-different-long-random-string-at-least-32-characters"

SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Owner Name"
SEED_OWNER_TITLE="Owner"

INVITATION_EXPIRES_IN_DAYS="7"
INVITATION_VERIFICATION_CODE_EXPIRES_IN_DAYS="7"
INVITATION_VERIFICATION_CODE_MAX_ATTEMPTS="5"
INVITATION_VERIFICATION_CODE_LENGTH="8"
INVITATION_SHORT_TOKEN_EXPIRES_IN_DAYS="7"
INVITATION_SHORT_TOKEN_LENGTH="8"
SESSION_EXPIRES_IN_DAYS="14"
REMEMBER_ME_SESSION_EXPIRES_IN_DAYS="30"
STEP_UP_EXPIRES_IN_MINUTES="5"
STEP_UP_MAX_ATTEMPTS="5"
MAX_LEAVE_IMPORT_FILE_SIZE_MB="10"

# Identity verification must not use mock in production.
IDENTITY_VERIFICATION_PROVIDER="manual"

COOKIE_DOMAIN=""
EMAIL_PROVIDER="resend"
EMAIL_FROM="no-reply@your-production-domain.example"
EMAIL_REPLY_TO=""
RESEND_API_KEY=""
EXTERNAL_EMAIL_NOTIFICATIONS_ENABLED="true"
SLACK_NOTIFICATIONS_ENABLED="false"
SLACK_WEBHOOK_URL=""
SLACK_NOTIFY_JOB_FAILURES="true"
SLACK_NOTIFY_LEAVE_REQUESTS="false"
LOG_LEVEL="info"

# Current implementation supports local private storage only.
# Do not rely on local storage for production attachments on Vercel serverless.
LEAVE_ATTACHMENT_STORAGE="local"
MAX_LEAVE_ATTACHMENT_SIZE_MB="10"
PRIVATE_UPLOAD_DIR="private/uploads"

# Future object storage integration.
# BLOB_READ_WRITE_TOKEN=""
# LEAVE_ATTACHMENT_STORAGE="vercel-blob"
